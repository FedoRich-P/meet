# Server port (Render/Railway set PORT automatically)
PORT=5000

# Public URL of the app — for CORS and correct meeting links in production
# Example: https://meet.yourdomain.com
PUBLIC_ORIGIN=

# Optional: Metered.ca API key for TURN (fixes audio/video across different networks)
# Free signup: https://dashboard.metered.ca/signup — then create TURN credential / API key
# Put the credential's "Show API Key" value here (NOT username/password, NOT Secret Key)
METERED_API_KEY=

# Metered app subdomain (from dashboard), without .metered.live — e.g. meet-uedq
# If unset, server tries meet-uedq then meet
METERED_DOMAIN=

# Extra CORS origins, comma-separated (optional)
# ALLOWED_ORIGINS=https://chat-websocket-beryl.vercel.app

# MongoDB Atlas connection string (Database → Connect → Drivers)
# Example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/meet?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=
